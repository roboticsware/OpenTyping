<UserControl x:Name="SelfControl"
             x:Class="OpenTyping.VeneziaMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:OpenTyping" 
             xmlns:flags="clr-namespace:FamFamFam.Flags.Wpf;assembly=FamFamFam.Flags.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="500"
             d:DesignWidth="800">
    <UserControl.Resources>
        <local:IndexConverter x:Key="IndexConverter"/>
        <flags:CountryIdToFlagImageSourceConverter x:Key="CountryIdToFlagImageSourceConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                    Margin="14 5 14 0">
            <StackPanel DockPanel.Dock="Top"
                         Orientation="Vertical">
                <StackPanel Orientation="Horizontal"
                             Margin="0 0 0 2">
                    <Rectangle Width="40" 
                               Height="40"
                               Margin="0 0 9 0"
                               Fill="#212529">
                        <Rectangle.OpacityMask>
                            <VisualBrush Visual="{iconPacks:FontAwesome Kind=StarSolid}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Style="{StaticResource NormalTextBlock}" 
                               Name="MenuName"
                               Text="사마르칸트 유성"
                               FontSize="32pt"
                               Margin="0 2 0 0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource NormalTextBlock}" 
                            Name="MenuDesc"
                            Text=":떨어지는 유성을 요격하여 사마르칸트의 푸른 돔 사원을 지킵니다."
                            FontSize="14pt"/>
            </StackPanel>
            <Grid DockPanel.Dock="Bottom">
                <mah:MetroAnimatedTabControl x:Name="RankTabControl" mah:TabControlHelper.Underlined="TabPanel"
                                             SelectionChanged="Tab_SelectionChanged">
                    <TabItem Name="TabLocal">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Name="RectLocal"
                                           Style="{StaticResource TabItemIconRectangle}" 
                                           Width="25" 
                                           Height="15">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform"
                                                     Visual="{iconPacks:FontAwesome Kind=DatabaseSolid}"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Label x:Name="TabLbl1" Style="{StaticResource MahApps.Styles.Label}" Content="Local"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ListView Name="LVlocal"
                                   Margin="2"
                                   BorderThickness="0"
                                   SelectedIndex="0"
                                   AlternationCount="10"
                                   Style="{StaticResource MahApps.Styles.ListView.Virtualized}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn x:Name="Header1" DisplayMemberBinding="{Binding Converter={StaticResource IndexConverter},
                                            RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}}" Header="Rank" Width="40"/>
                                    <GridViewColumn x:Name="Header2" DisplayMemberBinding="{Binding Name}" Header="Name" Width="150"/>
                                    <GridViewColumn x:Name="Header15" Header="Country" Width="25">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Path=Country, Converter={StaticResource CountryIdToFlagImageSourceConverter}}"
                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn x:Name="Header3" DisplayMemberBinding="{Binding Org}" Header="Org" Width="180"/>
                                    <GridViewColumn x:Name="Header16" Header="Character" Width="80" DisplayMemberBinding="{Binding Character}"/>
                                    <GridViewColumn x:Name="Header4" DisplayMemberBinding="{Binding Level}" Header="Level" Width="60"/>
                                    <GridViewColumn x:Name="Header5" DisplayMemberBinding="{Binding Score}" Header="Score" Width="100"/>
                                    <GridViewColumn x:Name="Header7" DisplayMemberBinding="{Binding Date}" Header="Date" Width="120"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Name="TabServer">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Name="RectServer"
                                           Style="{StaticResource TabItemIconRectangle}" 
                                           Width="25" 
                                           Height="15">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform"
                                                     Visual="{iconPacks:FontAwesome Kind=ServerSolid}"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Label x:Name="TabLbl2" Style="{StaticResource MahApps.Styles.Label}" Content="Server"/>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Name="NotSupport" FontSize="20"/>
                        </StackPanel>
                    </TabItem>
                </mah:MetroAnimatedTabControl>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Row="1"
                   LastChildFill="False"
                   Margin="0 0 5 5">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Rectangle Style="{StaticResource TabItemIconRectangle}" 
                            Width="35" 
                            Height="25"
                            Fill="#37b24d">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform"
                                     Visual="{iconPacks:FontAwesome Kind=UserSolid}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Name="TBlblName" Margin="0" FontWeight="Bold" FontSize="15" Text="Name:" VerticalAlignment="Center"/>
                <TextBox Name="TBname" MaxLength="30" Width="130" Margin="0 0 0 0" FontSize="20"></TextBox>

                <ComboBox Width="60" x:Name="CountryPicker" ItemsSource="{Binding Source={x:Static flags:CountryData.AllCountries}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="flags:CountryData">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Path=Iso2, Converter={StaticResource CountryIdToFlagImageSourceConverter}}"
                                       Stretch="None" Width="35" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <Rectangle Style="{StaticResource TabItemIconRectangle}" 
                            Width="35" 
                            Height="25">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform"
                                     Visual="{iconPacks:FontAwesome Kind=SchoolSolid}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Name="TBlblOrg" Margin="5" FontWeight="Bold" FontSize="15" Text="Organization:" VerticalAlignment="Center"/>
                <TextBox Name="TBorg" MaxLength="50" Width="130" FontSize="20"></TextBox>
            </StackPanel>
            <Button x:Name="StartButton"
                    DockPanel.Dock="Right"
                    Click="StartButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="18"
                               Height="15" 
                               Fill="Green">
                        <Rectangle.OpacityMask>
                            <VisualBrush Visual="{iconPacks:Modern Kind=ArrowRight}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Style="{StaticResource ControlButtonText}"
                               Name="StartBtn"
                               Text="게임 시작"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
